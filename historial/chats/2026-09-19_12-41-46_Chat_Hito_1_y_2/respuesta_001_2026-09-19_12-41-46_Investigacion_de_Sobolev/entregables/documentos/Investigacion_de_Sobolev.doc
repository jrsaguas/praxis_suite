<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;"></div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">    if (run) {</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      particles.forEach(p =&gt; {</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        for (let i = 0; i &lt; 3; i++) {</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">          rk4(p, 0.02);</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">          p.trail.push([cx + p.x * sc, cy - p.y * sc]);</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">          if (p.trail.length &gt; 400) p.trail.shift();</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        }</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      });</div>
