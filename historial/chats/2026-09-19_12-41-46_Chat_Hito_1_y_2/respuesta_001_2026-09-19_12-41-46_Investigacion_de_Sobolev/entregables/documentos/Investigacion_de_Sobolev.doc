<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      if (p.trail.length &gt; 1) {</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        ctx.strokeStyle = p.color; ctx.lineWidth = 2;</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        ctx.beginPath();</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        ctx.moveTo(p.trail[0][0], p.trail[0][1]);</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        for (let i = 1; i &lt; p.trail.length; i++) ctx.lineTo(p.trail[i][0], p.trail[i][1]);</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">        ctx.stroke();</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      }</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      ctx.fillStyle = p.color;</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      ctx.beginPath();</div>
<div style="font-family:Consolas,monospace;font-size:8.5pt;color:#1e293b;background:#f8fafc;padding:1pt 6pt;white-space:pre;">      ctx.arc(cx + p.x * sc, cy - p.y * sc, 4.5, 0, 6.28);</div>
